# Sao chép thành .env (không commit). Giá trị thật chỉ nằm trên VPS / GitHub Secrets.
ENV=dev

# --- Database (apps/api) ---
# App dùng URL qua pooler (Neon: host có đuôi -pooler). Dán nguyên URL postgresql://... được,
# app tự đổi sang driver psycopg.
DATABASE_URL=postgresql://vdrama:vdrama@localhost:5432/vdrama
# Migration dùng URL direct (không qua pooler). Trống thì dùng DATABASE_URL.
DATABASE_URL_DIRECT=
# Tinh chỉnh pool (mặc định ở app/core/config.py). Tổng kết nối = số worker x (pool + overflow).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=10
# DB_CONNECT_TIMEOUT=10

# --- Auth (apps/api) ---
# Khóa ký access token, >= 32 byte ngẫu nhiên. Bắt buộc ở prod (app không khởi động nếu thiếu).
# Dev để trống: mỗi lần chạy tự sinh khóa (khởi động lại thì access token cũ hết hạn, refresh vẫn được).
# Sinh khóa: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
# Origin của site (kiểm tra CSRF). Prod: https://vdrama.vn
PUBLIC_ORIGIN=http://localhost:3000
# Cookie chỉ gửi qua HTTPS. Dev chạy http://localhost nên đặt false; prod bắt buộc true.
COOKIE_SECURE=false
# Đọc IP thật từ CF-Connecting-IP. Prod bắt buộc true (sau Caddy mọi request cùng một IP);
# firewall VPS phải chỉ mở 80/443 cho dải IP Cloudflare, nếu không ai cũng giả được IP. Dev: false.
TRUST_CLOUDFLARE_IP=false

# --- Cloudflare Stream (apps/api) ---
# Dev để trống được: endpoint xem phim trả 503, phần còn lại vẫn chạy.
# Prod bắt buộc CUSTOMER_CODE, SIGNING_KEY_ID/PEM, WEBHOOK_SECRET (app không khởi động nếu thiếu).
# API token cần quyền Stream:Edit; chỉ dùng cho upload, đồng bộ trạng thái và lệnh cài đặt.
CF_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
# Phần <code> của domain phát customer-<code>.cloudflarestream.com
CF_STREAM_CUSTOMER_CODE=
# Khóa ký token xem phim: dán nguyên giá trị `id` và `pem` (đã mã base64) Cloudflare trả về.
CF_STREAM_SIGNING_KEY_ID=
CF_STREAM_SIGNING_KEY_PEM=
CF_STREAM_WEBHOOK_SECRET=
# Hạn token xem phim (phút), tự kéo dài theo thời lượng tập, tối đa 1440 (24 giờ).
# STREAM_TOKEN_TTL_MINUTES=180
# Kích thước file video tối đa admin được upload (byte), mặc định 10 GB.
# STREAM_MAX_UPLOAD_BYTES=10737418240

# Test cần Postgres (CI luôn đặt; trống thì các test đó tự bỏ qua)
TEST_DATABASE_URL=postgresql://vdrama:vdrama@localhost:5432/vdrama

# --- Web (apps/web) ---
# Local không có Caddy: chuyển /api/* sang FastAPI
API_PROXY_TARGET=http://localhost:8000
# Server Next.js gọi API catalog qua mạng nội bộ (Docker: http://api:8000). Trống: http://localhost:8000
API_INTERNAL_URL=http://localhost:8000
# Chỉ dev: luồng HLS mẫu công khai để thử player khi chưa có Cloudflare Stream (bản build prod bỏ qua)
# NEXT_PUBLIC_DEV_SAMPLE_HLS=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8
