# Sao chép thành .env (không commit). Giá trị thật chỉ nằm trên VPS / GitHub Secrets.
ENV=dev

# --- Database (apps/api) ---
# App dùng URL qua pooler (Neon: host có đuôi -pooler). Dán nguyên URL postgresql://... được,
# app tự đổi sang driver psycopg.
DATABASE_URL=postgresql://vdrama:vdrama@localhost:5432/vdrama
# Migration dùng URL direct (không qua pooler). Trống thì dùng DATABASE_URL.
DATABASE_URL_DIRECT=
# Tinh chỉnh pool (mặc định ở app/core/config.py). Tổng kết nối = số worker x (pool + overflow).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=10
# DB_CONNECT_TIMEOUT=10

# --- Auth (apps/api) ---
# Khóa ký access token, >= 32 byte ngẫu nhiên. Bắt buộc ở prod (app không khởi động nếu thiếu).
# Dev để trống: mỗi lần chạy tự sinh khóa (khởi động lại thì access token cũ hết hạn, refresh vẫn được).
# Sinh khóa: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
# Origin của site (kiểm tra CSRF). Prod: https://vdrama.vn
PUBLIC_ORIGIN=http://localhost:3000
# Cookie chỉ gửi qua HTTPS. Dev chạy http://localhost nên đặt false; prod bắt buộc true.
COOKIE_SECURE=false
# Chỉ bật khi API nằm sau Cloudflare và firewall chỉ mở cho dải IP Cloudflare.
TRUST_CLOUDFLARE_IP=false

# Test cần Postgres (CI luôn đặt; trống thì các test đó tự bỏ qua)
TEST_DATABASE_URL=postgresql://vdrama:vdrama@localhost:5432/vdrama

# --- Web (apps/web) ---
# Local không có Caddy: chuyển /api/* sang FastAPI
API_PROXY_TARGET=http://localhost:8000
